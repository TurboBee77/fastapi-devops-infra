global:
  scrape_interval: 15s

scrape_configs:
  - job_name: node-exporter
    static_configs:
      - targets: ["{{ hostvars[groups['ci'][0]]['private_ip'] }}:9100"]
        labels:
          role: ci
      - targets: ["{{ hostvars[groups['app'][0]]['private_ip'] }}:9100"]
        labels:
          role: app
      - targets: ["{{ hostvars[groups['monitoring'][0]]['private_ip'] }}:9100"]
        labels:
          role: monitoring

  - job_name: fastapi-app
    metrics_path: /metrics
    static_configs:
      - targets: ["{{ hostvars[groups['app'][0]]['private_ip'] }}:8000"]
